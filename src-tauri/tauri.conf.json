{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZJU English Helper",
  "version": "../package.json",
  "identifier": "com.macanine.zjueh",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3300",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "大英默写器 Pro",
        "width": 1100,
        "height": 800,
        "minWidth": 400,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
